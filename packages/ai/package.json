{
  "name": "@rfsanz/ai",
  "version": "0.2.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test":      "jest --passWithNoTests",
    "example":             "node -r ts-node/register src/trading-brain/example.ts",
    "orchestrator:example":"node -r ts-node/register src/orchestrator/example.ts",
    "decision:example":    "node -r ts-node/register src/decision-engine/example.ts",
    "strategy:example":    "node -r ts-node/register src/strategy-engine/example.ts",
    "portfolio:example":   "node -r ts-node/register src/portfolio-intelligence/example.ts"
  },
  "dependencies": {
    "@rfsanz/database":  "workspace:*",
    "@rfsanz/logger":    "workspace:*",
    "axios":             "^1.7.9",
    "eventemitter3":     "^5.0.0",
    "mustache":          "^4.2.0",
    "node-fetch":        "^3.3.2",
    "p-retry":           "^5.0.0",
    "uuid":              "^9.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": false }
  },
  "devDependencies": {
    "@nestjs/common":     "^10.4.19",
    "@nestjs/core":       "^10.4.19",
    "@types/jest":        "^29.5.14",
    "@types/mustache":    "^4.1.1",
    "@types/node":        "^20.0.0",
    "@types/uuid":        "^9.0.0",
    "jest":               "^29.7.0",
    "reflect-metadata":   "^0.2.2",
    "ts-jest":            "^29.3.4",
    "ts-node":            "^10.9.1",
    "typescript":         "~5.9.3"
  }
}
