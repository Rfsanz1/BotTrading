# ═════════════════════════════════════════════════════════════════
# TRADING BOT CONFIGURATION - READY FOR PRODUCTION
# ═════════════════════════════════════════════════════════════════

# ═════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═════════════════════════════════════════════════════════════════
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bottrading
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:changeme@postgres:5432/bottrading?schema=public"

# ═════════════════════════════════════════════════════════════════
# API SERVER CONFIGURATION
# ═════════════════════════════════════════════════════════════════
NODE_ENV=production
API_PORT=3000
PORT=3000
API_HOST=0.0.0.0

# ═════════════════════════════════════════════════════════════════
# JWT AUTHENTICATION
# ═════════════════════════════════════════════════════════════════
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=your_jwt_secret_key_here

# ═════════════════════════════════════════════════════════════════
# BINANCE CONFIGURATION - CHOOSE ONE MODE:
# ═════════════════════════════════════════════════════════════════

# MODE 1: TESTNET (SAFE - for testing)
# Uncomment these lines:
# BINANCE_USE_TESTNET=true
# BINANCE_BASE_URL=https://testnet.binance.vision
# BINANCE_API_KEY=your_testnet_key
# BINANCE_API_SECRET=your_testnet_secret

# MODE 2: MAINNET (REAL MONEY - for production)
# Uncomment these lines:
BINANCE_USE_TESTNET=false
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=your_mainnet_api_key_here
BINANCE_API_SECRET=your_mainnet_api_secret_here

# ═════════════════════════════════════════════════════════════════
# TRADING SAFETY LIMITS
# ═════════════════════════════════════════════════════════════════
# Maximum order value in USD
TRADING_MAX_ORDER_VALUE_USD=500

# Daily loss limit (stops trading if reached) in USD
TRADING_DAILY_LOSS_LIMIT_USD=1000

# Maximum position size as % of account
TRADING_MAX_POSITION_SIZE_PERCENT=10

# Minimum account balance to enable trading in USD
TRADING_MIN_ACCOUNT_BALANCE_USD=50

# Maximum concurrent open positions
TRADING_MAX_CONCURRENT_POSITIONS=5

# Cooldown period after stop-loss (minutes)
TRADING_COOLDOWN_AFTER_LOSS_MINUTES=60

# Maximum risk percentage per trade
TRADING_MAX_RISK_PERCENT=5

# ═════════════════════════════════════════════════════════════════
# RATE LIMITING
# ═════════════════════════════════════════════════════════════════
RATE_LIMIT_THRESHOLD=0.8
RATE_LIMIT_RETRY_ATTEMPTS=3
RATE_LIMIT_RETRY_DELAY_MS=1000

# ═════════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ═════════════════════════════════════════════════════════════════
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/trading-bot/app.log

# ═════════════════════════════════════════════════════════════════
# MONITORING & ALERTS
# ═════════════════════════════════════════════════════════════════
HEALTH_CHECK_INTERVAL=300
BALANCE_CHANGE_ALERT_PERCENT=5
LOSS_ALERT_PERCENT=10

# ═════════════════════════════════════════════════════════════════
# REDIS (Optional - for caching)
# ═════════════════════════════════════════════════════════════════
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# ═════════════════════════════════════════════════════════════════
# EMAIL NOTIFICATIONS (Optional)
# ═════════════════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL_TO=admin@example.com

# ═════════════════════════════════════════════════════════════════
# AI PROVIDERS (Optional)
# ═════════════════════════════════════════════════════════════════
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ============================================
# TELEGRAM (Optional)
# ============================================
TELEGRAM_BOT_TOKEN=

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
