{
  "name": "@rfsanz/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run test:security",
    "test:security": "pnpm --dir ../../packages/exchange exec jest --config ../../apps/api/jest.config.js --runInBand apps/api/src/modules/alerts/__tests__/webhook-security.spec.ts apps/api/src/__tests__/event-names.spec.ts",
    "test:integration": "set -a && if [ -f ./.env.paper ]; then . ./.env.paper; else . ./.env.paper.example; fi && set +a && pnpm --dir ../../packages/exchange exec jest --config ../../apps/api/jest.config.js --runInBand apps/api/src/integration/db-backed-proof.spec.ts",
    "test:all": "set -a && if [ -f ./.env.paper ]; then . ./.env.paper; else . ./.env.paper.example; fi && set +a && pnpm --dir ../../packages/exchange exec jest --config ../../apps/api/jest.config.js --runInBand",
    "start": "node dist/main.js",
    "credentials:testnet:create": "pnpm run build && node dist/modules/credentials/operator-cli-entry.js",
    "auth:password-reset": "pnpm run build && node dist/modules/auth/password-reset-operator-entry.js",
    "auth:bootstrap-password": "pnpm run build && node dist/modules/auth/password-bootstrap-operator-entry.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:paper": "set -a && if [ -f ./.env.paper ]; then . ./.env.paper; else . ./.env.paper.example; fi && set +a && pnpm --dir ../.. doctor:db && pnpm --dir ../.. doctor:redis && pnpm db:generate && pnpm db:migrate && pnpm dev",
    "db:generate": "pnpm --dir ../../packages/database prisma:generate",
    "db:migrate": "pnpm --dir ../../packages/database migrate:deploy",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^6.0.0",
    "@nestjs/websockets": "^10.0.0",
    "@prisma/client": "^5.10.0",
    "@rfsanz/database": "workspace:*",
    "@rfsanz/exchange": "workspace:*",
    "@rfsanz/tradingview": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "compression": "^1.7.4",
    "express": "^4.18.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pino": "^8.0.0",
    "pino-http": "^11.0.0",
    "prom-client": "^14.0.1",
    "rate-limiter-flexible": "^2.3.6",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "ws": "^8.13.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.3",
    "@types/express": "^4.17.20",
    "@types/jest": "29.5.14",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^3.0.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3"
  }
}
